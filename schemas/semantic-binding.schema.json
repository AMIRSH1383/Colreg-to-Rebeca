{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic symbol binding result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "rule_id",
    "bindings",
    "unresolved_concepts"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "partial"
      ],
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entity",
          "concept",
          "statement_ids",
          "target",
          "match_type",
          "reason",
          "evidence",
          "limitations"
        ],
        "properties": {
          "kind": {
            "enum": [
              "entity",
              "concept"
            ],
            "type": "string"
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": [
              "string",
              "null"
            ]
          },
          "statement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "instances",
              "variable"
            ],
            "properties": {
              "class": {
                "type": "string",
                "minLength": 1
              },
              "instances": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "variable": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "match_type": {
            "enum": [
              "exact",
              "semantic"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "pointer"
              ],
              "properties": {
                "input": {
                  "enum": [
                    "colreg",
                    "rebeca"
                  ],
                  "type": "string"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolved_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entity",
          "concept",
          "statement_ids",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "entity",
              "concept"
            ],
            "type": "string"
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": [
              "string",
              "null"
            ]
          },
          "statement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
