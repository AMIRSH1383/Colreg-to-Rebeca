{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic COLREG semantics v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "ok"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "statements",
        "references"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "uniqueItems": true
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "minItems": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "open_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "schema_version": {
      "const": 2
    },
    "formalization": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "required": [
    "status",
    "rule_id",
    "extraction",
    "open_assumptions",
    "schema_version",
    "formalization"
  ],
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "statementId": {
      "type": "string",
      "pattern": "^stmt[0-9]{2,}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "source_text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entityId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "source_text",
        "subjects",
        "concept",
        "predicate",
        "operator",
        "value",
        "unit",
        "applies_when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/statementId"
        },
        "role": {
          "type": "string",
          "enum": [
            "scope",
            "condition",
            "obligation",
            "prohibition",
            "exception",
            "definition"
          ]
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityId"
          },
          "uniqueItems": true
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!=",
            "in",
            "not_in",
            null
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "applies_when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statementId"
          },
          "uniqueItems": true
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text",
        "reason"
      ],
      "properties": {
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rule_id",
        "extraction",
        "open_assumptions"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities",
            "statements",
            "references"
          ],
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity"
              },
              "uniqueItems": true
            },
            "statements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              },
              "minItems": 1
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "open_assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "phase",
        "agent",
        "message"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "phase": {
          "const": "extraction"
        },
        "agent": {
          "const": "colreg_extractor"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "compare",
            "and",
            "or",
            "not",
            "implies",
            "true",
            "false",
            "unsupported"
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!=",
            null
          ]
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "required": [
        "op",
        "entity",
        "concept",
        "operator",
        "value",
        "unit",
        "args"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "statement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "support": {
          "type": "string",
          "enum": [
            "state",
            "unsupported"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "obligation",
            "prohibition"
          ]
        },
        "applicability": {
          "$ref": "#/$defs/expression"
        },
        "obligation": {
          "$ref": "#/$defs/expression"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "temporal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "statement_ids",
        "support",
        "reason",
        "kind",
        "applicability",
        "obligation",
        "exceptions",
        "temporal"
      ]
    }
  }
}
