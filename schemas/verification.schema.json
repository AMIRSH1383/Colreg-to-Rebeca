{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COLREG-to-Rebeca verification gate result",
  "type": "object",
  "required": [
    "verified",
    "verification_status",
    "verification_outcome",
    "rmc_exit_code",
    "rmc_details",
    "vacuity_status",
    "mutation_score",
    "mutation_details",
    "passes_gate",
    "optional_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "verified": {
      "type": "boolean"
    },
    "verification_status": {
      "enum": [
        "satisfied",
        "violated",
        "unknown",
        "execution_failed",
        "compilation_failed",
        "verification_failed"
      ]
    },
    "verification_outcome": {
      "type": "string"
    },
    "rmc_exit_code": {
      "type": "integer"
    },
    "rmc_details": {
      "type": "object"
    },
    "vacuity_status": {
      "type": [
        "object",
        "null"
      ]
    },
    "mutation_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "mutation_details": {
      "type": [
        "object",
        "null"
      ]
    },
    "passes_gate": {
      "type": "boolean"
    },
    "optional_checks": {
      "type": "object",
      "required": [
        "vacuity",
        "mutation"
      ],
      "additionalProperties": false,
      "properties": {
        "vacuity": {
          "enum": [
            "disabled",
            "not_run",
            "unknown",
            "passed",
            "failed"
          ]
        },
        "mutation": {
          "enum": [
            "disabled",
            "not_run",
            "unknown",
            "passed",
            "failed"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passes_gate": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "verified": {
            "const": true
          },
          "verification_status": {
            "const": "satisfied"
          },
          "verification_outcome": {
            "const": "satisfied"
          },
          "optional_checks": {
            "properties": {
              "vacuity": {
                "enum": [
                  "passed",
                  "disabled"
                ]
              },
              "mutation": {
                "enum": [
                  "passed",
                  "disabled"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
