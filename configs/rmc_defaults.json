{
  "version": "2.14",
  "description": "Reference defaults; pass execution options explicitly to the CLIs.",
  "download": {
    "source": "https://github.com/rebeca-lang/org.rebecalang.rmc/releases/download/2.14/rmc-2.14.jar",
    "sha256": "a39112046d99e0895cf47f890242ace21db896e609f7eef86751a0d416d477f5"
  },
  "execution": {
    "timing_mode": "TIMED_REBECA",
    "default_timeout_seconds": 120,
    "jvm_opts": [
      "-Xmx2g"
    ]
  },
  "paths": {
    "rmc_jar": "~/.rebeca/rmc.jar",
    "model_dir": "inputs/rebeca",
    "output_dir": "output"
  }
}
