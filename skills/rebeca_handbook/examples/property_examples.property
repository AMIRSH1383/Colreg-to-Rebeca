// Illustrative safety condition, not a complete formalization of COLREG.
property {
  define {
    longVessel = (s1.ship_length >= 50);
    hasLight = (s1.masthead_light_on == true);
    rangeOk = (s1.masthead_light_range >= 6);
  }
  Assertion {
    ExampleRange: !longVessel || !hasLight || rangeOk;
  }
}
