// Illustrative finite model; unrelated to the preserved original research model.
reactiveclass Ship(10) {
  statevars {
    int ship_length;
    int masthead_light_range;
    boolean masthead_light_on;
  }
  Ship(int length) {
    ship_length = length;
    masthead_light_range = 6;
    masthead_light_on = true;
  }
  msgsrv setLight(int new_range) {
    masthead_light_range = new_range;
  }
}
main {
  Ship s1():(50);
}
