{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mapping-agent contract",
  "description": "Input and output schemas for the mapping-agent (Step03). Consumes abstraction summary and produces concept mapping (surgical patches only, no file I/O).",

  "definitions": {
    "ErrorEnvelope": {
      "type": "object",
      "required": ["status", "phase", "agent", "message"],
      "additionalProperties": false,
      "properties": {
        "status":  { "type": "string", "const": "error" },
        "phase":   { "type": "string", "const": "step04" },
        "agent":   { "type": "string", "const": "mapping-agent" },
        "message": { "type": "string", "minLength": 1 }
      }
    },

    "Artifact": {
      "type": "object",
      "required": ["path", "content"],
      "additionalProperties": false,
      "properties": {
        "path":    { "type": "string", "description": "Absolute path the file was written to." },
        "content": { "type": "string", "description": "Full text content of the generated file." }
      }
    },

    "VariableEntry": {
      "type": "object",
      "required": ["legata_concept", "rebeca_class", "rebeca_statevar", "rebeca_type", "rebeca_init_value", "is_new"],
      "additionalProperties": false,
      "properties": {
        "legata_concept":    { "type": "string" },
        "legata_var":        { "type": "string" },
        "legata_value":      { "type": "string" },
        "rebeca_class":      { "type": "string" },
        "rebeca_statevar":   { "type": "string" },
        "rebeca_type":       { "type": "string", "enum": ["boolean", "int"] },
        "bounds": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "rebeca_init_value": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "is_new":            { "type": "boolean" }
      }
    },

    "ActorEntry": {
      "type": "object",
      "required": ["legata_actor", "rebeca_class", "rebeca_instance"],
      "additionalProperties": false,
      "properties": {
        "legata_actor":    { "type": "string" },
        "rebeca_class":    { "type": "string" },
        "rebeca_instance": { "type": "string" }
      }
    },

    "AbstractionSummary": {
      "type": "object",
      "required": ["naming_contract", "actor_map", "variable_map"],
      "additionalProperties": true,
      "properties": {
        "naming_contract": { "type": "object" },
        "actor_map":       { "type": "array", "items": { "$ref": "#/definitions/ActorEntry" } },
        "variable_map":    { "type": "array", "items": { "$ref": "#/definitions/VariableEntry" } }
      }
    },

    "StateVarPatch": {
      "type": "object",
      "required": ["reactiveclass", "add_statevars"],
      "additionalProperties": false,
      "properties": {
        "reactiveclass": { "type": "string" },
        "add_statevars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "init"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["boolean", "int"] },
              "name": { "type": "string" },
              "init": { "type": "string", "description": "Plain value or Rebeca OWA ?(val1, val2, ...)" }
            }
          }
        }
      }
    },

    "QueueSizePatch": {
      "type": "object",
      "required": ["reactiveclass", "queue_size"],
      "additionalProperties": false,
      "properties": {
        "reactiveclass": { "type": "string" },
        "queue_size": { "type": "integer", "minimum": 1 }
      }
    },

    "DefinePatch": {
      "type": "object",
      "required": ["ap", "expr"],
      "additionalProperties": false,
      "properties": {
        "ap":   { "type": "string", "description": "Boolean Atomic Proposition name (camelCase)" },
        "expr": { "type": "string", "description": "Expression using instance.statevar, comparisons, || and &&" }
      }
    },

    "ConceptMapping": {
      "type": "object",
      "required": ["statevar_patches", "queue_size_patches", "define_patches", "assertion_lines"],
      "additionalProperties": false,
      "properties": {
        "statevar_patches": {
          "type": "array",
          "items": { "$ref": "#/definitions/StateVarPatch" },
          "description": "List of new statevars to add per reactiveclass (only is_new==true vars)"
        },
        "queue_size_patches": {
          "type": "array",
          "items": { "$ref": "#/definitions/QueueSizePatch" },
          "description": "Queue size updates per reactiveclass (may be empty)"
        },
        "define_patches": {
          "type": "array",
          "items": { "$ref": "#/definitions/DefinePatch" },
          "description": "Boolean Atomic Propositions to add to property define block (may be empty)"
        },
        "assertion_lines": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Assertion lines of form RuleN: !cond || excl || assure; (non-empty)"
        }
      }
    }
  },

  "input": {
    "type": "object",
    "required": ["rule_id", "legata_input", "abstraction_summary", "output_dir"],
    "additionalProperties": false,
    "properties": {
      "rule_id":             { "type": "string", "minLength": 1 },
      "legata_input":         { "type": "string", "minLength": 1 },
      "abstraction_summary": { "$ref": "#/definitions/AbstractionSummary" },
      "output_dir":          { "type": "string", "minLength": 1 }
    }
  },

  "output": {
    "oneOf": [
      {
        "type": "object",
        "required": ["status", "rule_id", "concept_mapping", "open_assumptions"],
        "additionalProperties": false,
        "properties": {
          "status":           { "type": "string", "const": "ok" },
          "rule_id":          { "type": "string" },
          "concept_mapping":  { "$ref": "#/definitions/ConceptMapping" },
          "open_assumptions": { "type": "array", "items": { "type": "string" } }
        }
      },
      { "$ref": "#/definitions/ErrorEnvelope" }
    ]
  }
}
